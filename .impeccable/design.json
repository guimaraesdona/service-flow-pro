      "html": "<button class=\"ds-btn-primary\">Finalizar OS</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:8px 16px;border:0;border-radius:6px;background:hsl(var(--primary));color:hsl(var(--primary-foreground));font:500 14px/20px 'Inter Variable',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms cubic-bezier(.4,0,.2,1)}.ds-btn-primary:hover{background:hsl(var(--primary)/.9)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background)),0 0 0 4px hsl(var(--ring))}"
    },
    {
      "name": "Botão outline",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Ações secundárias: Imprimir, Editar, desvios de status.",
      "html": "<button class=\"ds-btn-outline\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9V2h12v7\"/><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"/><rect x=\"6\" y=\"14\" width=\"12\" height=\"8\"/></svg>Imprimir</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 16px;border:1px solid hsl(var(--input));border-radius:6px;background:hsl(var(--card));color:hsl(var(--foreground));font:500 14px/20px 'Inter Variable',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-btn-outline:hover{background:hsl(var(--accent));color:hsl(var(--accent-foreground))}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background)),0 0 0 4px hsl(var(--ring))}"
    },
