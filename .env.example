# Credenciais do projeto Supabase.
#
# O Vite inlina estas variáveis em tempo de BUILD, não em runtime: elas precisam
# existir na máquina/CI que roda `pnpm build`, senão o bundle publicado sobe sem
# credenciais. Para desenvolvimento local, copie este arquivo para `.env.local`.
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key>
